// BAY backend schema — see docs/backend-design.md §2.
// Notion is the source of truth for content (articles, news): those rows carry
// their notion_page_id and are written only by the sync worker. The member
// roster is owned by this database — seeded and edited via scripts/seed-members.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7) — the runtime client
// gets a driver adapter in PrismaService instead.
datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  active
  alumni
}

// Shared by articles and news: drafts sync into the DB but never leave the API.
enum ContentStatus {
  draft
  published
  archived
}

// Cover-art palettes — mirrors `Accent` in the frontend's lib/research.ts.
enum Accent {
  blue
  violet
  teal
  indigo
}

enum SyncResource {
  articles
  news
}

enum SyncTrigger {
  cron
  manual
  webhook
}

enum SyncStatus {
  running
  ok
  error
}

model Member {
  id     String @id @default(uuid()) @db.Uuid
  slug   String @unique
  name   String
  cohort Int
  team   String
  // 팀장 / 부장 / 부원 / 회장 …
  position String
  bio      String @default("")
  // [{ label: SocialLabel, href: string }] — validated at sync time against
  // the frontend's 7-label union; a per-member read never needs a join.
  socials Json @default("[]")
  // Re-hosted copy (S3/R2), never the expiring Notion file URL.
  avatarUrl String?      @map("avatar_url")
  status    MemberStatus @default(active)
  // Roster visibility on the site; hidden members still resolve as bylines.
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  articles ArticleAuthor[]
  curated  NewsItem[]

  @@index([cohort, team])
  @@map("members")
}

model Article {
  id       String @id @default(uuid()) @db.Uuid
  slug     String @unique
  title    String
  dek      String
  // Free text on purpose: the tag-chip list is `SELECT DISTINCT category`,
  // same derivation the frontend uses today.
  category String
  accent   Accent        @default(blue)
  status   ContentStatus @default(draft)
  publishedAt DateTime?  @map("published_at") @db.Date
  featured    Boolean    @default(false)
  // Block[] — the exact contract of the frontend's lib/research.ts, so the
  // renderer consumes API responses unchanged.
  body Json
  // Precomputed at sync: 500 chars/min (Korean), min 1.
  readingMinutes Int     @default(1) @map("reading_minutes")
  // Page-view counter — owned by the API (sync never writes it), incremented
  // by POST /v1/articles/:slug/view.
  views Int @default(0)
  // Optional real artwork; null falls back to the generated CoverArt.
  coverUrl  String? @map("cover_url")
  mediumUrl String? @map("medium_url")

  notionPageId       String   @unique @map("notion_page_id")
  notionLastEditedAt DateTime @map("notion_last_edited_at")

  authors ArticleAuthor[]

  @@index([status, publishedAt(sort: Desc)])
  @@map("articles")
}

// Join table from day one: co-authored research is a matter of time, and the
// frontend can render authors[0] until it's ready for the full list.
model ArticleAuthor {
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String  @map("article_id") @db.Uuid
  member    Member  @relation(fields: [memberId], references: [id])
  memberId  String  @map("member_id") @db.Uuid
  ord       Int     @default(0)

  @@id([articleId, memberId])
  @@map("article_authors")
}

model NewsItem {
  id    String @id @default(uuid()) @db.Uuid
  // Routable page identity — explicit Notion Slug property, or derived from
  // the page id so curators never have to invent one.
  slug  String @unique
  title String
  // Deliberately NOT unique. It was, on the theory that the same story curated
  // twice is an edit — and then two curators wrote up the same Re-protocol
  // piece from different angles and the team ruled both belong on the site.
  // The write-up is the item and the link is shared context; identity lives in
  // notionPageId (sync) and slug (routing). Uniqueness here also let archived
  // ghosts block a re-entered story's insert for a day at a time.
  // Nullable because a quarter of the published items carry no link — the
  // curator's write-up is the piece, and the original is a courtesy.
  url        String?
  sourceName String  @default("") @map("source_name")
  // The curator's one-line take — the value-add of the feature.
  summary  String
  // Block[] — 요약/인사이트 authored in the Notion page body; [] = link-only.
  body  Json    @default("[]")
  // The 리서치팀's own "이번 주 꼭 볼 것" checkbox, rather than something the
  // site infers from dates.
  pick  Boolean @default(false)
  // The original story's og:image, fetched once at sync time — the card
  // fallback when the write-up itself carries no picture. Null = generated
  // cover art.
  coverUrl String? @map("cover_url")
  // Notion's Topic is a multi-select and stories genuinely carry two or three
  // — 보안 and DeFi at once. Ordered as the curator tagged them, so the first
  // is the one a cramped surface shows.
  categories String[]
  // Original publication date of the story, not the curation date.
  publishedAt DateTime      @map("published_at") @db.Date
  curator     Member?       @relation(fields: [curatorId], references: [id])
  curatorId   String?       @map("curator_id") @db.Uuid
  status      ContentStatus @default(draft)

  notionPageId String   @unique @map("notion_page_id")
  syncedAt     DateTime @updatedAt @map("synced_at")

  @@index([status, publishedAt(sort: Desc)])
  @@index([categories], type: Gin)
  @@map("news_items")
}

model SyncRun {
  id       String       @id @default(uuid()) @db.Uuid
  resource SyncResource
  trigger  SyncTrigger
  status   SyncStatus   @default(running)
  // { created, updated, archived, skipped, failed, warnings: string[] } — one
  // page failing to map or upsert lands here instead of killing the run.
  stats      Json      @default("{}")
  error      String?
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([resource, startedAt(sort: Desc)])
  @@map("sync_runs")
}

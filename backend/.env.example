# --- required ---
DATABASE_URL=postgresql://user:password@localhost:5432/bay

# --- server ---
PORT=4000
# comma-separated allowed origins for CORS (the Next.js site)
CORS_ORIGIN=http://localhost:3000

# --- notion sync (required once sync lands) ---
NOTION_TOKEN=
NOTION_DB_MEMBERS=
NOTION_DB_ARTICLES=
NOTION_DB_NEWS=
# shared secret for POST /v1/sync/* triggers
SYNC_KEY=

# --- frontend cache invalidation ---
REVALIDATE_URL=
REVALIDATE_SECRET=

# --- avatar re-hosting (S3-compatible: R2/S3/MinIO) ---
# unset = sync still runs, avatars are skipped with a warning
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

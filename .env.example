# Contact form delivery (app/api/contact/route.ts)

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional. Where form submissions land.
# CONTACT_TO=blockchainatyonsei@gmail.com

# Optional. Sender address. Resend's shared sender works before you verify a
# domain; once bay.example is verified in Resend, switch to that domain so mail
# stops landing in spam.
# CONTACT_FROM=BAY Website <noreply@yourdomain.com>
